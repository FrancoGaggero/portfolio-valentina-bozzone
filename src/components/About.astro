---
import about from '../data/about.json';
---

<section id="about" class="py-20 px-6 bg-gray-50">
  <div class="container mx-auto max-w-6xl">
    
    <!-- Two Column Layout: Content Left, Image Right -->
    <div class="grid lg:grid-cols-2 gap-12 items-start mb-16">
      
      <!-- Left Column: About & Education -->
      <div class="space-y-16 about-left-column">
        
        <!-- Simple About -->
        <div>
          <h2 class="text-4xl md:text-5xl font-display font-light mb-8 text-black ">
            {about.heading}
          </h2>

          <p class="text-lg md:text-xl text-gray-600 leading-relaxed mb-12">
            {about.bio}
          </p>
        </div>

        <!-- Education & Certifications -->
        <div>
          <div class="mb-12">
            <h3 class="text-2xl md:text-3xl font-display font-light text-black mb-4">
              {about.formationHeading}
            </h3>
            <p class="text-gray-600">
            {about.formationSubtitle}
            </p>
          </div>

          <div class="space-y-6">
            {about.education.map((item) => (
              <div class="bg-white p-6 rounded-lg shadow-lg border border-gray-100 hover:shadow-md transition-shadow duration-300">
                <div class="flex items-center space-x-4 mb-4">
                  <div class="w-12 h-12 bg-black rounded-lg flex items-center justify-center">
                    <span class={`text-white font-bold ${item.badge.length > 3 ? 'text-xs' : 'text-sm'}`}>{item.badge}</span>
                  </div>
                  <div>
                    <h4 class="text-lg font-medium text-black">{item.name}</h4>
                    <p class="text-sm text-gray-500">{item.subtitle}</p>
                  </div>
                </div>
                <p class="text-gray-600 text-sm leading-relaxed">
                  {item.description}
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>
      
      <!-- Right Column: Image -->
      <div class="lg:sticky lg:top-8 about-right-column ">
        <div class="relative">
          <div class="aspect-[3/4] rounded-2xl overflow-hidden shadow-xl">
            <img
              src={about.image}
              alt={about.imageAlt}
              width="1440"
              height="1920"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </div>
          <!-- Elegant overlay gradient -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent rounded-2xl"></div>
        </div>
      </div>
    </div>
    
    <!-- Skills & Tools -->
    <div class="mb-16 about-skills-section">
      <div class="text-center mb-12">
        <h3 class="text-2xl md:text-3xl font-display font-light text-black mb-4">
          Herramientas & Plataformas
        </h3>
        <p class="text-gray-600">
          Tecnologías que uso para crear experiencias excepcionales
        </p>
      </div>
      
      <div class="flex flex-wrap justify-center gap-6 max-w-4xl mx-auto">
        
        <!-- Creative Tools -->
        <div class="flex items-center space-x-3 bg-white px-6 py-3 rounded-full shadow-sm border border-gray-100 hover:shadow-xl transition-shadow duration-300">
          <div class="w-8 h-8 bg-gradient-to-br from-blue-600 to-purple-600 rounded-lg flex items-center justify-center">
            <span class="text-white text-xs font-bold">Ps</span>
          </div>
          <span class="text-gray-700 font-medium">Photoshop</span>
        </div>

        <div class="flex items-center space-x-3 bg-white px-6 py-3 rounded-full shadow-sm border border-gray-100 hover:shadow-xl transition-shadow duration-300">
          <div class="w-8 h-8 bg-gradient-to-br from-orange-500 to-pink-500 rounded-lg flex items-center justify-center">
            <span class="text-white text-xs font-bold">Ai</span>
          </div>
          <span class="text-gray-700 font-medium">Illustrator</span>
        </div>

        <!-- Social Media -->
        <div class="flex items-center space-x-3 bg-white px-6 py-3 rounded-full shadow-sm border border-gray-100 hover:shadow-xl transition-shadow duration-300">
          <div class="w-8 h-8 bg-gradient-to-br from-pink-500 to-rose-600 rounded-lg flex items-center justify-center">
            <span class="text-white text-xs">📷</span>
          </div>
          <span class="text-gray-700 font-medium">Instagram</span>
        </div>

        <div class="flex items-center space-x-3 bg-white px-6 py-3 rounded-full shadow-sm border border-gray-100 hover:shadow-xl transition-shadow duration-300">
          <div class="w-8 h-8 bg-gradient-to-br from-purple-500 to-blue-500 rounded-lg flex items-center justify-center">
            <span class="text-white text-xs">🎬</span>
          </div>
          <span class="text-gray-700 font-medium">CapCut</span>
        </div>

        <div class="flex items-center space-x-3 bg-white px-6 py-3 rounded-full shadow-sm border border-gray-100 hover:shadow-xl transition-shadow duration-300">
          <div class="w-8 h-8 bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg flex items-center justify-center">
            <span class="text-white text-xs font-bold">TR</span>
          </div>
          <span class="text-gray-700 font-medium">Trello</span>
        </div>

        <div class="flex items-center space-x-3 bg-white px-6 py-3 rounded-full shadow-sm border border-gray-100 hover:shadow-xl transition-shadow duration-300">
          <div class="w-8 h-8 bg-black rounded-lg flex items-center justify-center">
            <span class="text-white text-xs font-bold">TT</span>
          </div>
          <span class="text-gray-700 font-medium">TikTok</span>
        </div>
        
        <div class="flex items-center space-x-3 bg-white px-6 py-3 rounded-full shadow-sm border border-gray-100 hover:shadow-xl transition-shadow duration-300">
          <div class="w-8 h-8 bg-gradient-to-br from-orange-500 to-red-500 rounded-lg flex items-center justify-center">
            <span class="text-white text-xs font-bold">MC</span>
          </div>
          <span class="text-gray-700 font-medium">Metricool</span>
        </div>

        <div class="flex items-center space-x-3 bg-white px-6 py-3 rounded-full shadow-sm border border-gray-100 hover:shadow-xl transition-shadow duration-300">
          <div class="w-8 h-8 bg-gradient-to-br from-purple-500 to-pink-500 rounded-lg flex items-center justify-center">
            <span class="text-white text-xs">🎨</span>
          </div>
          <span class="text-gray-700 font-medium">Canva Pro</span>
        </div>
      </div>
    </div>
    
    <!-- Three Simple Services -->
    <div class="grid md:grid-cols-3 gap-8 about-services-section">
      {about.services.map((service) => (
        <div class="text-center p-6 hover:bg-white transition-colors duration-300">
          <div class="w-16 h-16 bg-black rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white text-2xl">{service.icon}</span>
          </div>
          <h3 class="text-lg font-medium text-black mb-2">{service.title}</h3>
          <p class="text-gray-600 text-sm">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Cargar Anime.js desde CDN para About
  function loadAnimeForAbout() {
    // Verificar si Anime.js ya está cargado (desde Hero)
    // @ts-ignore
    if (typeof anime !== 'undefined') {
      initAboutAnimations();
    } else {
      // Cargar desde CDN si no está disponible
      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js';
      script.onload = () => {
        initAboutAnimations();
      };
      document.head.appendChild(script);
    }
  }
  
  function initAboutAnimations() {
    // Configurar estado inicial de las columnas
    const leftColumn = document.querySelector('.about-left-column') as HTMLElement;
    const rightColumn = document.querySelector('.about-right-column') as HTMLElement;
    const skillsSection = document.querySelector('.about-skills-section') as HTMLElement;
    const servicesSection = document.querySelector('.about-services-section') as HTMLElement;
    
    if (leftColumn && rightColumn) {
      // Ocultar inicialmente las columnas
      leftColumn.style.opacity = '0';
      leftColumn.style.transform = 'translateX(-100px)';
      rightColumn.style.opacity = '0';
      rightColumn.style.transform = 'translateX(100px)';
      
      if (skillsSection) {
        skillsSection.style.opacity = '0';
        skillsSection.style.transform = 'translateY(50px)';
      }
      
      if (servicesSection) {
        servicesSection.style.opacity = '0';
        servicesSection.style.transform = 'translateY(50px)';
      }
    }
    
    // Configurar Intersection Observer para activar las animaciones
    const observerOptions = {
      threshold: 0.2,
      rootMargin: '-50px 0px'
    };
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && entry.target.id === 'about') {
          // Crear timeline para las animaciones coordinadas
          // @ts-ignore - anime is loaded globally
          const tl = anime.timeline({
            easing: 'easeOutCubic',
            duration: 1000
          });
          
          // Animación principal: columnas que se encuentran
          tl.add({
            targets: '.about-left-column',
            translateX: [-100, 0],
            opacity: [0, 1],
            duration: 1200,
            easing: 'easeOutBack'
          })
          .add({
            targets: '.about-right-column',
            translateX: [100, 0],
            opacity: [0, 1],
            duration: 1200,
            easing: 'easeOutBack'
          }, '-=1000') // Se superpone con la animación anterior
          
          // Efecto sutil de "magnetismo" - las columnas se acercan ligeramente
          .add({
            targets: '.about-left-column',
            translateX: [0, 10, 0],
            duration: 600,
            easing: 'easeInOutSine'
          }, '-=400')
          .add({
            targets: '.about-right-column',
            translateX: [0, -10, 0],
            duration: 600,
            easing: 'easeInOutSine'
          }, '-=600')
          
          // Animación de las skills con stagger (tipo pop-up)
          .add({
            targets: '.about-skills-section',
            translateY: [50, 0],
            opacity: [0, 1],
            duration: 800,
            easing: 'easeOutQuart'
          }, '-=200')
          
          // Animación de las herramientas individuales con efecto stagger
          .add({
            targets: '.about-skills-section > div > div > div',
            scale: [0.8, 1],
            opacity: [0, 1],
            // @ts-ignore - anime is loaded globally
            delay: anime.stagger(100),
            duration: 600,
            easing: 'easeOutElastic(1, .8)'
          }, '-=400')
          
          // Animación de los servicios
          .add({
            targets: '.about-services-section',
            translateY: [50, 0],
            opacity: [0, 1],
            duration: 800,
            easing: 'easeOutQuart'
          }, '-=600')
          
          // Animación individual de cada servicio
          .add({
            targets: '.about-services-section > div',
            translateY: [30, 0],
            scale: [0.9, 1],
            opacity: [0, 1],
            // @ts-ignore - anime is loaded globally
            delay: anime.stagger(200),
            duration: 700,
            easing: 'easeOutBack'
          }, '-=400');
          
          // Desconectar el observer después de la primera activación
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);
    
    // Observar la sección About
    const aboutSection = document.getElementById('about');
    if (aboutSection) {
      observer.observe(aboutSection);
    }
  }
  
  // Inicializar cuando el DOM esté listo
  document.addEventListener('DOMContentLoaded', () => {
    loadAnimeForAbout();
  });
  
  // También inicializar inmediatamente si el DOM ya está cargado
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadAnimeForAbout);
  } else {
    loadAnimeForAbout();
  }
</script>
